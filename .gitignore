# ---- 密钥与本地配置（任务书硬性要求：任何密钥不得入库）----
.env
.env.*
!.env.example
*.key
*.pem
secrets.*
*secret*
*credential*

# ---- Python ----
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# ---- 运行产物与数据缓存 ----
# 所有层级的运行目录均忽略；正式文档在 docs/，只放行审核后的交付分片。
**/runs/*
!/runs/releases/
/runs/releases/*
!/runs/releases/demo/
/runs/releases/demo/*
!/runs/releases/demo/README.md
!/runs/releases/demo/manifest.json
!/runs/releases/demo/Hy3-OJ-demo.zip.[0-9][0-9][0-9]
data/subsets/
docs/_pdf_extract.txt

# ---- 工具 ----
.streamlit/*
!.streamlit/config.toml
.vscode/
.idea/
.codebuddy/
